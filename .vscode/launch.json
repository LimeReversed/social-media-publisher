{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug main.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug current file (workspace cwd)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug unittest file",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["Tests.test_schedule_helper"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Debug unittest method",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "Tests.test_schedule_helper.ScheduleHelperTests.test_merge_platform_data__merges_each_platform_correctly"
      ],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
